enum FraudEventType {
  RISK_SCORE_CALCULATED
  VELOCITY_VIOLATION
  BOT_DETECTED
  ALERT_TRIGGERED
  MANUAL_REVIEW_FLAGGED
  SUSPICIOUS_PATTERN
