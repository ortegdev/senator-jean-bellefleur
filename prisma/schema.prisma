// USER ROLES (Simple role-based access)
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email    String   @unique
  name     String
  role     UserRole @default(VIEWER)
  
  // Authentication (simplified - use proper auth in production)
  passwordHash String?
  
  // Status
  active Boolean @default(true)
  
  @@index([email])
  @@index([role])
}

enum UserRole {
  OWNER      // Can change launch mode, checklist
  ADMIN      // Can manage content, view donations
  COMPLIANCE // Can edit compliance rules, review flagged donations
  VIEWER     // Can only view
}

// ISSUE PAGES (Policy positions and stances)
model Issue {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Identity
  slug String @unique

  // Title
