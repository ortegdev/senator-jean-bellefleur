  // Expiration (optional)
  expiresAt DateTime?
  
  @@index([emailNormalized])
  @@index([fingerprint])
}

// AUDIT LOG (Track important changes)
model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Event
  action     String
  entityType String
  entityId   String
  changes    Json // Old and new values

  // Actor
  userId    String?
  userEmail String?
  ipAddress String?

