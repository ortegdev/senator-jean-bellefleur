  UNDER_REVIEW
  WON
  LOST
  ACCEPTED
}


// ============================================================================
// PRIVACY & DATA PROTECTION
// ============================================================================

// DONOR MODEL (Extended with encryption fields)
// Note: Contribution model already references Donor, this extends it
model Donor {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Encrypted PII (AES-256-GCM)
  encryptedName  String // Field-level encryption with separate key
  encryptedEmail String // Field-level encryption with separate key

  // Blind indexes for searchable fields (HMAC-SHA256)
  emailBlindIndex String @unique // Keyed hash of normalized email
  nameBlindIndex  String // Keyed hash of normalized name

  // Non-sensitive data
  country       String
  locale        String @default("en")
  isAnonymous   Boolean @default(false)
  anonymizedAt  DateTime?

  // ROOTS BY COMMUNE (Optional family connection)
  rootsCommune String? // Commune slug or "other" or "elsewhere"

  // Legal hold (prevents deletion during investigation/litigation)
  legalHold           Boolean @default(false)
  legalHoldReason     String? @db.Text
  legalHoldSetBy      String?
  legalHoldSetAt      DateTime?
  legalHoldReleasedBy String?
  legalHoldReleasedAt DateTime?

  // Relationships
  contributions       Contribution[]
  consents            Consent[]
  dataSubjectRequests DataSubjectRequest[]
  mySupportSessions   MySupportSession[]
  supporterPage       SupporterPage?

  @@index([emailBlindIndex])
  @@index([nameBlindIndex])
  @@index([legalHold])
  @@index([anonymizedAt])
  @@index([rootsCommune])
}

// CONSENT RECORDS
model Consent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Donor linkage
  donorId String
  donor   Donor  @relation(fields: [donorId], references: [id], onDelete: Cascade)

  // Consent details
  purpose ConsentPurpose
  status  ConsentStatus  @default(PENDING)
  basis   ConsentBasis

  // Timestamps
  grantedAt   DateTime?
  withdrawnAt DateTime?

  // Audit trail (captured at consent time)
  ipAddress String?
  userAgent String? @db.Text
  locale    String
  
  // Legal record
  consentText String @db.Text // Exact text shown to user
  version     String @default("1.0") // Consent version for audit

  @@index([donorId])
  @@index([purpose, status])
  @@index([grantedAt])
}

enum ConsentPurpose {
  EMAIL // Email communications
  WHATSAPP // WhatsApp communications
  PUBLIC_RECOGNITION // Public display of name
  ESSENTIAL // Transaction processing (auto-granted)
}


enum ConsentBasis {
  EXPLICIT_CONSENT // User explicitly opted in (GDPR Article 6(1)(a))
  IMPLIED_CONSENT // Implied from transaction (CASL)
  LEGITIMATE_INTEREST // Business necessity (GDPR Article 6(1)(f))
  CONTRACT // Necessary for contract (GDPR Article 6(1)(b))
  LEGAL_OBLIGATION // Required by law (GDPR Article 6(1)(c))
}

// DATA SUBJECT REQUESTS (GDPR/CCPA/PIPEDA Rights)

enum DataSubjectRequestType {
  ACCESS // Right to access (data export)
  ERASURE // Right to be forgotten
  RECTIFICATION // Right to correction
  PORTABILITY // Right to data portability
  OBJECT // Right to object to processing
  RESTRICT_PROCESSING // Right to restrict processing
}

enum RequestStatus {
  PENDING // Awaiting verification
  IN_PROGRESS // Verified, being processed
  COMPLETED // Fulfilled
  DENIED // Denied with reason
  CANCELLED // Cancelled by requester
}

// MY SUPPORT SESSIONS (Passwordless auth)
model MySupportSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Donor linkage
  donorId String
  donor   Donor  @relation(fields: [donorId], references: [id], onDelete: Cascade)

  // Session token (magic link)
  token String @unique

  // Expiry
  expiresAt      DateTime
  lastAccessedAt DateTime

  // Security
  ipAddress String?
  userAgent String? @db.Text

  @@index([donorId])
  @@index([token])
  @@index([expiresAt])
}

// DATA RETENTION POLICIES (Configurable by counsel)
model RetentionPolicy {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Entity type
  entityType String @unique // 'Contribution', 'Donor', 'Consent', etc.

  // Retention period
  retentionPeriodDays Int // e.g., 2555 days = 7 years

  // Actions allowed
  canAnonymize Boolean @default(true)
  canDelete    Boolean @default(false)

  // Legal basis
  legalBasis String @db.Text // Why we retain this data

  // Enabled
  enabled Boolean @default(true)

  @@index([entityType])
}

// AUDIT LOG (For privacy compliance)
model PrivacyAuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Action
  action     String // 'CONSENT_GRANTED', 'DATA_EXPORTED', 'DATA_DELETED', etc.
  entityType String // 'Donor', 'Consent', 'DataSubjectRequest', etc.
  entityId   String // ID of affected entity

  // Actor
  actorType String // 'USER', 'SYSTEM', 'ADMIN'
  actorId   String? // User ID or 'system'

  // Details (scrubbed of PII)
  details Json?

  // Context
  ipAddress String?
  userAgent String? @db.Text

  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}


// ============================================================================
// CHAPTERS, ROOTS & SUPPORTER PAGES (Community Layer)
// ============================================================================

// CHAPTERS (Diaspora organizing hubs by city/country)
model Chapter {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Identity
  slug String @unique // "miami-fl", "montreal-qc", "paris-france"
  name String // "Miami, FL", "Montreal, QC", "Paris, France"

  // Location
  city    String
  state   String? // For US/Canada
  country String // ISO 3166-1 alpha-2

  // Status
  status ChapterStatus @default(PENDING)

  // Approval workflow
  requestedBy        String // Email of organizer
  requestedAt        DateTime @default(now())
  approvedBy         String? // Admin user ID
  approvedAt         DateTime?
  rejectedBy         String?
  rejectedAt         DateTime?
  rejectionReason    String? @db.Text

  // Organizer
  organizerName         String?
  organizerEmail        String?
  organizerContactOptIn Boolean @default(false) // Show contact on public page

  // Description (markdown, admin-editable)
  descriptionHt String? @db.Text
  descriptionFr String? @db.Text
  descriptionEn String? @db.Text

  // Aggregate counts (updated periodically)
  memberCount      Int @default(0) // Supporters who joined this chapter
  totalAmountCents Int @default(0) // Aggregate of all member contributions

  // Settings
  showLeaderboard Boolean @default(false) // Show member leaderboard
  allowJoin       Boolean @default(true) // Allow new members to join

  // Events
  events ChapterEvent[]
  
  // Memberships
  memberships ChapterMembership[]
  
  // Relations from other models
  newsletterSubscribers NewsletterSubscriber[]
  publicEvents          Event[]

  // Moderation
  suspended       Boolean @default(false)
  suspendedBy     String?
  suspendedAt     DateTime?
  suspensionReason String? @db.Text
  
  // Moderation logs
  moderationLogs ChapterModerationLog[]

  @@index([slug])
  @@index([status])
  @@index([country])
  @@index([suspended])
}

enum ChapterStatus {
  PENDING  // Awaiting admin approval
  APPROVED // Active
  REJECTED // Application rejected
  ARCHIVED // No longer active
}

// CHAPTER MEMBERSHIP (Many-to-many)
model ChapterMembership {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Linkage
  chapterId      String
  chapter        Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  supporterPageId String
  supporterPage  SupporterPage @relation(fields: [supporterPageId], references: [id], onDelete: Cascade)

  // Status
  status MembershipStatus @default(ACTIVE)

  // Left/removed
  leftAt      DateTime?
  leftReason  String? @db.Text
  removedBy   String?
  removedAt   DateTime?
  removedReason String? @db.Text

  @@unique([chapterId, supporterPageId])
  @@index([chapterId])
  @@index([supporterPageId])
  @@index([status])
}

enum MembershipStatus {
  ACTIVE
  LEFT
  REMOVED
}

// CHAPTER EVENTS (Local organizing)
model ChapterEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Chapter linkage
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  // Event details
  titleHt     String
  titleFr     String
  titleEn     String
  descriptionHt String? @db.Text
  descriptionFr String? @db.Text
  descriptionEn String? @db.Text

  // Date & location
  eventDate DateTime
  location  String

  // Organizer
  organizerName  String
  organizerEmail String

  // Status
  status EventStatus @default(DRAFT)

  // Approval
  approvedBy String?
  approvedAt DateTime?

  @@index([chapterId])
  @@index([eventDate])
  @@index([status])
}


// SUPPORTER PAGES (/s/[slug])
model SupporterPage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Owner linkage (one per donor)
  donorId String @unique
  donor   Donor  @relation(fields: [donorId], references: [id], onDelete: Cascade)

  // Custom URL
  slug String @unique // "jeanbaptiste", "marie-claire-123"

  // Display name (public, scrubbed)
  displayName String // "Jean B.", "Marie-Claire"

  // Story (markdown, 500 chars max)
  storyHt String? @db.Text
  storyFr String? @db.Text
  storyEn String? @db.Text

  // Privacy settings
  showName             Boolean @default(true) // Show display name
  showRootsCommune     Boolean @default(false) // Show commune on page
  showChapterMembership Boolean @default(false) // Show chapter on page

  // Attribution tracking
  referralCount      Int @default(0) // Number of supporters who joined via this page
  referralAmountCents Int @default(0) // Total from referred supporters

  // Status
  status       SupporterPageStatus @default(ACTIVE)
  publishedAt  DateTime?

  // Moderation
  suspended       Boolean @default(false)
  suspendedBy     String?
  suspendedAt     DateTime?
  suspensionReason String? @db.Text
  reportCount     Int @default(0)

  // Chapter membership
  chapterMemberships ChapterMembership[]

  // Moderation reports
  reports SupporterPageReport[]

  @@index([slug])
  @@index([status])
  @@index([suspended])
  @@index([publishedAt])
}

enum SupporterPageStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  REMOVED
}

// SUPPORTER PAGE REPORTS (User flagging)
model SupporterPageReport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reported page
  supporterPageId String
  supporterPage   SupporterPage @relation(fields: [supporterPageId], references: [id], onDelete: Cascade)

  // Report details
  reason        SupporterPageReportReason
  reasonDetails String? @db.Text

  // Reporter (anonymous)
  reporterIp    String
  reporterEmail String? // Optional

  // Status
  status ReviewStatus @default(PENDING)

  // Resolution
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNotes   String? @db.Text
  actionTaken   String? // "no_action", "warning", "content_removed", "page_suspended"

  @@index([supporterPageId])
  @@index([status])
  @@index([createdAt])
}

enum SupporterPageReportReason {
  PROFANITY
  IMPERSONATION
  SPAM
  HARASSMENT
  INAPPROPRIATE_CONTENT
  OTHER
}

// RESERVED SLUGS (Prevent impersonation)
model ReservedSlug {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  slug   String @unique // "bellefleur", "campaign", "official", "senator"
  reason String @db.Text // Why it's reserved

  @@index([slug])
}

// ROOTS AGGREGATES (Cached counts by commune)
// Updated periodically from Donor.rootsCommune
model RootsAggregate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Commune identifier
  communeSlug String @unique // Matches Commune.slug or "other" or "elsewhere"

  // Aggregate count (suppressed if below minimum)
  supporterCount Int @default(0)
  isSuppressed   Boolean @default(false) // True if count < ROOTS_MIN_COUNT

  // Last calculation
  lastCalculatedAt DateTime @default(now())

  @@index([communeSlug])
  @@index([supporterCount])
}

// ATTRIBUTION TRACKING (Privacy-safe referral tracking)
model Attribution {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Referred contribution
  contributionId String       @unique
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  // Referrer (supporter page)
  referrerPageSlug String? // Null for organic/direct

  // Referral metadata
  referralSource String? // "supporter_page", "chapter_page", "social", etc.

  @@index([referrerPageSlug])
  @@index([createdAt])
}

// CHAPTER MODERATION LOG
model ChapterModerationLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Chapter
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  // Action
  action     String // "APPROVED", "REJECTED", "SUSPENDED", "UNSUSPENDED"
  actionBy   String // User ID
  actionByEmail String
  reason     String? @db.Text

  // Context
  metadata Json?

  @@index([chapterId])
  @@index([createdAt])
}


// ============================================================================
// ADMIN CONSOLE - RBAC, MFA, AUDIT, DATA SUBJECT REQUESTS
// ============================================================================

// ADMIN USERS (Role-based access control)
model AdminUser {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Identity
  email        String      @unique
  name         String
  role         AdminRole
  
  // Authentication (use proper auth provider in production)
  passwordHash String?
  
  // MFA (Required for OWNER, COMPLIANCE, FINANCE)
  mfaEnabled    Boolean @default(false)
  mfaSecret     String? // TOTP secret (encrypted)
  mfaBackupCodes String[] // Encrypted backup codes
  mfaEnabledAt  DateTime?
  
  // Status
  active         Boolean @default(true)
  suspended      Boolean @default(false)
  suspendedBy    String?
  suspendedAt    DateTime?
  suspensionReason String? @db.Text
  
  // Permissions
  canRevealPII   Boolean @default(false) // Additional permission flag
  
  // Invitation/Approval (Dual approval for OWNER/COMPLIANCE/FINANCE)
  invitedBy        String?
  invitedByEmail   String?
  invitedAt        DateTime?
  
  approvedBy       String? // First approver for privileged roles
  approvedByEmail  String?
  approvedAt       DateTime?
  
  secondApprovedBy      String? // Second approver
  secondApprovedByEmail String?
  secondApprovedAt      DateTime?
  
  // Login tracking
  lastLoginAt       DateTime?
  lastLoginIp       String?
  failedLoginCount  Int @default(0)
  lastFailedLoginAt DateTime?
  
  // Rate limiting for PII reveals
  piiRevealCount    Int @default(0) // Reset daily
  piiRevealResetAt  DateTime?
  
  // Relations
  sessions          AdminSession[]
  auditLogs         TamperEvidentAuditLog[] @relation("Actor")
  piiReveals        PIIReveal[]
  dataSubjectRequests DataSubjectRequest[]
  
  @@index([email])
  @@index([role])
  @@index([active])
}

enum AdminRole {
  OWNER       // Full access, can change launch mode, manage users
  COMPLIANCE  // Compliance rules, review queue, sanctions
  FINANCE     // Ledger, reconciliation, transfers, exports
  EDITOR      // Content management, intake, news
  MODERATOR   // Community features, Q&A, volunteers
  READ_ONLY   // View-only access to non-PII data
}

// ADMIN SESSIONS (Track active sessions, allow revocation)
model AdminSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User
  userId String
  user   AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Session Details
  token      String   @unique // Hashed session token
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  
  // Device Info
  ipAddress String?
  userAgent String? @db.Text
  
  // Revocation
  revoked     Boolean @default(false)
  revokedBy   String?
  revokedAt   DateTime?
  revokeReason String?
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([revoked])
}

// TAMPER-EVIDENT AUDIT LOG (Hash-chained, immutable)
model TamperEvidentAuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Sequence (strictly increasing, no gaps)
  sequenceNumber BigInt @unique
  
  // Event
  action     String
  entityType String
  entityId   String?
  changes    Json?
  
  // Actor
  actorId       String?
  actor         AdminUser? @relation("Actor", fields: [actorId], references: [id])
  actorEmail    String?
  actorRole     String?
  ipAddress     String?
  userAgent     String? @db.Text
  
  // Context
  reason      String? @db.Text // Required for privileged actions
  metadata    Json?
  
  // Hash Chain (tamper detection)
  previousHash String // SHA-256 hash of previous entry
  currentHash  String @unique // SHA-256 hash of this entry
  
  // Off-system backup (S3, external log service)
  backedUpAt   DateTime?
  backupRef    String? // Reference to external backup
  
  @@index([sequenceNumber])
  @@index([action])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// PII REVEAL TRACKING (Rate-limited, audit-logged)
model PIIReveal {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Admin who revealed
  adminId       String
  admin         AdminUser @relation(fields: [adminId], references: [id])
  adminEmail    String
  
  // What was revealed
  entityType String // "Contribution", "Donor", etc.
  entityId   String
  fields     String[] // Which PII fields: ["email", "name", "address"]
  
  // Required reason
  reason     String @db.Text
  
  // Context
  ipAddress  String?
  
  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// DATA SUBJECT REQUESTS (GDPR/Privacy)
model DataSubjectRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Request Type
  requestType DataSubjectRequestType
  
  // Subject (linked to Donor)
  donorId      String?
  donor        Donor? @relation(fields: [donorId], references: [id])
  subjectEmail String
  subjectName  String?
  
  // Status
  status       DataSubjectRequestStatus @default(PENDING)
  
  // Verification
  verified     Boolean @default(false)
  verifiedBy   String?
  verifiedAt   DateTime?
  verificationMethod String? // "email_link", "manual_review"
  
  // Processing
  assignedTo      String?
  assignedToUser  AdminUser? @relation(fields: [assignedTo], references: [id])
  processedBy     String?
  processedAt     DateTime?
  
  // Results
  dataExportUrl   String? // Signed URL for data export
  dataExportedAt  DateTime?
  deletionCompletedAt DateTime?
  
  // Legal Hold (Prevents deletion)
  legalHoldActive Boolean @default(false)
  legalHoldReason String? @db.Text
  legalHoldBy     String?
  legalHoldAt     DateTime?
  
  // Denial
  deniedAt        DateTime?
  deniedBy        String?
  denialReason    String? @db.Text
  
  // Communication
  contactEmail    String // Email for updates
  notes           String? @db.Text
  
  @@index([donorId])
  @@index([subjectEmail])
  @@index([status])
  @@index([requestType])
  @@index([createdAt])
}


enum DataSubjectRequestStatus {
  PENDING        // New request
  VERIFYING      // Awaiting identity verification
  VERIFIED       // Identity confirmed
  IN_PROGRESS    // Being processed
  COMPLETED      // Request fulfilled
  DENIED         // Request denied (with reason)
  CANCELLED      // Cancelled by requester
  ON_LEGAL_HOLD  // Cannot process due to legal hold
}

// BACKGROUND JOBS (For large exports, reconciliation, etc.)
model BackgroundJob {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Job Type
  jobType    String // "export_donations", "reconciliation", "email_campaign"
  jobSubtype String? // Additional classification
  
  // Status
  status     BackgroundJobStatus @default(PENDING)
  
  // Scheduling
  scheduledFor DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  
  // Progress
  progress       Float @default(0) // 0.0 to 1.0
  totalItems     Int?
  processedItems Int @default(0)
  
  // Results
  resultUrl    String? // S3 URL or file path
  resultSize   Int? // Size in bytes
  errorMessage String? @db.Text
  
  // Requester
  requestedBy      String
  requestedByEmail String
  
  // Input Parameters
  parameters Json?
  
  // Retry Logic
  retryCount Int @default(0)
  maxRetries Int @default(3)
  
  // Timeout
  timeoutAt  DateTime?
  
  @@index([jobType])
  @@index([status])
  @@index([requestedBy])
  @@index([createdAt])
  @@index([scheduledFor])
}

enum BackgroundJobStatus {
  PENDING    // Queued, not started
  RUNNING    // Currently executing
  COMPLETED  // Successfully completed
  FAILED     // Failed with error
  CANCELLED  // Cancelled by user
  TIMEOUT    // Exceeded timeout
}

// ALERT SETTINGS (Thresholds for admin notifications)
model AlertSetting {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Alert Type
  alertKey    String @unique // "high_risk_disputes", "webhook_failures", etc.
  
  // Configuration
  enabled     Boolean @default(true)
  threshold   Float? // Numeric threshold
  timeWindow  Int? // Time window in minutes
  
  // Notification Channels
  emailRecipients String[] // Admin emails to notify
  slackWebhook    String? // Optional Slack webhook
  
  // Alert Settings
  severity       AlertSeverity @default(WARNING)
  cooldownMinutes Int @default(60) // Minimum time between alerts
  
  // Metadata
  description String @db.Text
  updatedBy   String?
  
  @@index([alertKey])
  @@index([enabled])
}


// ALERT EVENTS (Fired alerts)
model AlertEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Alert
  alertKey   String
  
  // Event Details
  message    String @db.Text
  severity   AlertSeverity
  value      Float? // Actual value that triggered alert
  threshold  Float? // Threshold that was exceeded
  
  // Notification
  notified      Boolean @default(false)
  notifiedAt    DateTime?
  notifiedTo    String[] // Emails notified
  
  // Acknowledgement
  acknowledged   Boolean @default(false)
  acknowledgedBy String?
  acknowledgedAt DateTime?
  
  // Related entities
  relatedType String?
  relatedId   String?
  metadata    Json?
  
  @@index([alertKey])
  @@index([createdAt])
  @@index([acknowledged])
}

// SYSTEM HEALTH METRICS (Track system health)
model HealthMetric {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Metric Type
  metricType String // "webhook_failures", "job_queue_depth", "error_rate"
  
  // Value
  value      Float
  
  // Time Series
  timestamp  DateTime @default(now())
  
  // Metadata
  labels     Json? // Additional dimensions
  
  @@index([metricType, timestamp])
  @@index([createdAt])
}

// DEMO DATA SEED TRACKING (Prevent running in production)
model DemoDataSeed {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Seed Information
  seedType    String // "contributions", "volunteers", "events"
  environment String // Must be "development" or "staging"
  recordCount Int
  
  // Execution
  executedBy     String
  executedAt     DateTime @default(now())
  
  // Cleanup
  cleanedUp   Boolean @default(false)
  cleanedUpAt DateTime?
  
  // Block production seeds
  @@index([environment])
  @@index([createdAt])
}

// SAVED VIEWS (User-defined table filters/sorts)
model SavedView {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // View Identity
  name        String
  description String?
  
  // Table
  tableType   String // "donations", "compliance_reviews", etc.
  
  // Filters
  filters     Json
  
  // Sort
  sortBy      String?
  sortOrder   String? // "asc" or "desc"
  
  // Columns
  visibleColumns String[]
  
  // Owner
  userId      String
  
  // Sharing
  isPublic    Boolean @default(false)
  
  @@index([userId])
  @@index([tableType])
}

// WEBHOOK FAILURE TRACKING (For system health monitoring)
model WebhookFailure {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Provider
  provider      String
  eventType     String
  
  // Event
  eventId       String
  payload       Json
  
  // Failure Details
  errorMessage  String @db.Text
  httpStatus    Int?
  retryCount    Int @default(0)
  
  // Resolution
  resolved      Boolean @default(false)
  resolvedAt    DateTime?
  resolvedBy    String?
  resolutionNote String? @db.Text
  
  @@index([provider])
  @@index([resolved])
  @@index([createdAt])
}

