{
  "name": "diaspora4bellefleur",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:whatsapp && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/visual-regression.spec.ts",
    "test:smoke": "tsx scripts/production-smoke-test.ts",
    "test:load": "tsx scripts/load-test.ts",
    "audit:content": "tsx scripts/pre-launch-audit.ts",
    "lighthouse": "lhci autorun",
    "check:whatsapp": "tsx scripts/check-whatsapp-violations.ts",
    "vercel:build": "prisma migrate deploy && prisma generate && npm run check:whatsapp && npm run build",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:audit": "npm audit --audit-level=moderate",
    "security:deps": "npm outdated",
    "security:secrets": "git secrets --scan",
    "upgrade:check": "tsx scripts/check-upgrade-compatibility.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@sentry/nextjs": "^8.50.0",
    "bcrypt": "^5.1.1",
    "next": "^15.1.6",
    "next-intl": "^4.15.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^17.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.3",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.49.1",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prisma": "^6.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
