{
  "name": "diaspora4bellefleur",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:whatsapp && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/visual-regression.spec.ts",
    "test:smoke": "tsx scripts/production-smoke-test.ts",
    "test:load": "tsx scripts/load-test.ts",
    "audit:content": "tsx scripts/pre-launch-audit.ts",
    "lighthouse": "lhci autorun",
    "check:whatsapp": "tsx scripts/check-whatsapp-violations.ts",
    "vercel:build": "npm run check:whatsapp && npm run build",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:audit": "npm audit --audit-level=moderate",
    "security:deps": "npm outdated",
    "security:secrets": "git secrets --scan"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "@sentry/nextjs": "^11.14.0",
    "bcrypt": "^5.1.1",
    "crypto": "^1.0.1",
    "next": "14.0.4",
    "next-intl": "^4.15.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stripe": "^23.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.2",
    "@playwright/test": "^1.40.1",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.0.4",
    "postcss": "^8",
    "prettier": "^3.1.1",
    "prisma": "^5.7.0",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.7.0",
    "typescript": "^5",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  }
}
